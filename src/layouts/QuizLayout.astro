---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'PKM Profile — Practical PKM',
  description = 'Discover your PKM strengths and growth areas across 5 key dimensions. Take the free 3-minute assessment and get personalized insights.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- OG / Social -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://quiz.practicalpkm.com" />
    <meta property="og:image" content="https://quiz.practicalpkm.com/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="PKM Profile — Practical PKM. A radar chart showing scores across 5 PKM dimensions." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://quiz.practicalpkm.com/og-image.png" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Prevent flash of wrong theme -->
    <script is:inline>
      (function() {
        var stored = localStorage.getItem('pkm-quiz-theme');
        var theme = stored || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
  @import '../styles/quiz.css';
  @import '../styles/animations.css';
</style>
